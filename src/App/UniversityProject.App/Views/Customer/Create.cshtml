@model UniversityProject.Core.Entities.Customer
@{
    ViewData["Title"] = "Create Customer";
    Layout = "_Layout";
}

<style>
    html, body {
        color-scheme: dark;
    }

    .form-container {
        max-width: 900px;
        margin: 0 auto;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }

    .form-group {
        margin-bottom: 24px;
    }

    .form-label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: var(--fg-muted);
        margin-bottom: 8px;
        letter-spacing: 0.3px;
        text-transform: uppercase;
    }

    .form-input, .form-textarea {
        width: 100%;
        padding: 14px 16px;
        background-color: var(--bg-deep) !important;
        border: 1.5px solid var(--border);
        border-radius: 12px;
        color: var(--fg) !important;
        font-size: 14px;
        font-family: 'DM Sans', sans-serif;
        outline: none;
        transition: all 0.3s ease;
        box-sizing: border-box;
    }

        .form-input:focus, .form-textarea:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-glow);
        }

    .form-textarea {
        resize: vertical;
        min-height: 100px;
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--accent), #008f55);
        color: #000;
        border: none;
        padding: 12px 24px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 14px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s;
    }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 20px rgba(0, 201, 120, 0.3);
        }

    .btn-secondary {
        background: transparent;
        color: var(--fg-muted);
        border: 1px solid var(--border);
        padding: 12px 24px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s;
    }

        .btn-secondary:hover {
            border-color: var(--fg-muted);
            color: var(--fg);
        }

    .form-actions {
        display: flex;
        gap: 12px;
        justify-content: flex-end;
        margin-top: 32px;
        padding-top: 24px;
        border-top: 1px solid var(--border);
    }

    .page-header {
        max-width: 900px;
        margin-left: auto;
        margin-right: auto;
    }

    @@media (max-width: 768px) {
        .form-grid {
            grid-template-columns: 1fr;
        }

        .page-header {
            max-width: 100%;
        }
    }
</style>

<div class="page-header">
    <h1>Create New Customer</h1>
    <p>Fill in the details below to add a new customer to your system.</p>
</div>

<div class="panel form-container">
    <form asp-action="Create" asp-controller="Customer" method="post" data-loader>
        @Html.AntiForgeryToken()

        <div class="form-grid">
            <div class="form-group">
                <label class="form-label" asp-for="Name">Customer Name</label>
                <input type="text" asp-for="Name" class="form-input" placeholder="e.g., John Doe" required>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="Phone">Phone Number</label>
                <input type="text" asp-for="Phone" class="form-input" placeholder="e.g., +1234567890">
            </div>
        </div>

        <div class="form-grid">
            <div class="form-group">
                <label class="form-label" asp-for="Email">Email Address</label>
                <input type="email" asp-for="Email" class="form-input" placeholder="e.g., customer@email.com">
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="OpeningBalance">Opening Balance ($)</label>
                <input type="number" asp-for="OpeningBalance" class="form-input" placeholder="0.00" step="0.01" min="0">
            </div>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="Address">Address</label>
            <textarea asp-for="Address" class="form-textarea" placeholder="Enter customer address..."></textarea>
        </div>

        <div class="form-actions">
            <a href="@Url.Action("Index", "Customers")" class="btn-secondary">Cancel</a>
            <button type="submit" class="btn-primary">
                <i class="fas fa-check"></i> Save Customer
            </button>
        </div>
    </form>
</div>