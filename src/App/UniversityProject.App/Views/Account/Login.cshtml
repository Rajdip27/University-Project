@model UniversityProject.Application.ViewModel.Auth.LoginViewModel
@{
    Layout = null;
    var alertMessage = TempData["AlertMessage"]?.ToString();
    var alertType = TempData["AlertType"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inventory Management System</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        :root {
            --bg-deep: #0a0f0d;
            --bg-panel: #111a16;
            --bg-card: #162019;
            --bg-card-hover: #1c2b22;
            --fg: #e8efe9;
            --fg-muted: #7a9484;
            --fg-dim: #4a6a56;
            --accent: #00c978;
            --accent-glow: rgba(0, 201, 120, 0.15);
            --accent-warm: #f0a830;
            --accent-warm-glow: rgba(240, 168, 48, 0.12);
            --border: #1e3028;
            --border-light: #253a2e;
            --card-shadow: 0 4px 24px rgba(0,0,0,0.4);
            --glass: rgba(16, 28, 22, 0.85);
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--bg-deep);
            color: var(--fg);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            position: relative;
        }
        .bg-layer { position: fixed; inset: 0; z-index: 0; overflow: hidden; }
        .bg-layer::before {
            content: ''; position: absolute; top: -30%; left: -20%;
            width: 70vw; height: 70vw;
            background: radial-gradient(circle, rgba(0,201,120,0.06) 0%, transparent 65%);
            animation: drift1 20s ease-in-out infinite;
        }
        .bg-layer::after {
            content: ''; position: absolute; bottom: -20%; right: -15%;
            width: 55vw; height: 55vw;
            background: radial-gradient(circle, rgba(240,168,48,0.04) 0%, transparent 60%);
            animation: drift2 25s ease-in-out infinite;
        }
        @@keyframes drift1 {
            0%, 100% { transform: translate(0, 0) scale(1); }
            33% { transform: translate(8%, 5%) scale(1.05); }
            66% { transform: translate(-3%, -4%) scale(0.97); }
        }
        @@keyframes drift2 {
            0%, 100% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(-6%, -8%) scale(1.08); }
        }
        .grid-pattern {
            position: fixed; inset: 0; z-index: 0;
            background-image:
                linear-gradient(rgba(0,201,120,0.02) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0,201,120,0.02) 1px, transparent 1px);
            background-size: 60px 60px;
            mask-image: radial-gradient(ellipse at 50% 50%, black 30%, transparent 80%);
        }
        .particles { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
        .particle {
            position: absolute; width: 3px; height: 3px;
            background: var(--accent); border-radius: 50%;
            opacity: 0; animation: float-particle linear infinite;
        }
        @@keyframes float-particle {
            0% { opacity: 0; transform: translateY(100vh) scale(0); }
            10% { opacity: 0.6; }
            90% { opacity: 0.3; }
            100% { opacity: 0; transform: translateY(-10vh) scale(1); }
        }
        .topbar {
            position: relative; z-index: 10;
            display: flex; align-items: center; justify-content: space-between;
            padding: 16px 40px;
            border-bottom: 1px solid var(--border);
            background: rgba(10, 15, 13, 0.8);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
        }
        .topbar-left { display: flex; align-items: center; gap: 14px; }
        .topbar-logo {
            width: 36px; height: 36px;
            background: linear-gradient(135deg, var(--accent), #008f55);
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 16px; color: #000; font-weight: 800;
            box-shadow: 0 0 20px var(--accent-glow);
        }
        .topbar-title {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 17px; font-weight: 600;
            letter-spacing: -0.3px; color: var(--fg);
        }
        .topbar-right { display: flex; align-items: center; gap: 8px; }
        .topbar-btn {
            background: transparent; border: 1px solid var(--border);
            color: var(--fg-muted); padding: 7px 16px; border-radius: 8px;
            font-size: 13px; font-family: 'DM Sans', sans-serif; cursor: pointer;
            transition: all 0.25s ease; display: flex; align-items: center; gap: 6px;
        }
        .topbar-btn:hover { border-color: var(--accent); color: var(--accent); background: var(--accent-glow); }
        .topbar-btn.active { background: var(--accent-glow); border-color: var(--accent); color: var(--accent); }
        .topbar-sun {
            color: var(--accent-warm); font-size: 16px; margin-left: 8px;
            animation: sun-pulse 4s ease-in-out infinite;
        }
        @@keyframes sun-pulse {
            0%, 100% { filter: drop-shadow(0 0 4px rgba(240,168,48,0.3)); }
            50% { filter: drop-shadow(0 0 12px rgba(240,168,48,0.6)); }
        }
        .main-content {
            position: relative; z-index: 5; flex: 1;
            display: flex; align-items: center; justify-content: center;
            padding: 40px; gap: 80px;
        }
        .dashboard-preview {
            flex: 1; max-width: 520px;
            animation: slideInLeft 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
        }
        @@keyframes slideInLeft {
            from { opacity: 0; transform: translateX(-40px); }
            to { opacity: 1; transform: translateX(0); }
        }
        .preview-header { display: flex; align-items: center; gap: 12px; margin-bottom: 32px; }
        .preview-header i { font-size: 22px; color: var(--accent); }
        .preview-header h2 {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 24px; font-weight: 700; letter-spacing: -0.5px;
        }
        .preview-header span { color: var(--fg-muted); font-size: 13px; font-weight: 400; margin-left: 4px; }
        .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
        .stat-card {
            background: var(--bg-card); border: 1px solid var(--border);
            border-radius: 16px; padding: 24px; position: relative;
            overflow: hidden; transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
            cursor: default; animation: cardFadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
        }
        .stat-card:nth-child(1) { animation-delay: 0.15s; }
        .stat-card:nth-child(2) { animation-delay: 0.25s; }
        .stat-card:nth-child(3) { animation-delay: 0.35s; }
        .stat-card:nth-child(4) { animation-delay: 0.45s; }
        @@keyframes cardFadeIn {
            from { opacity: 0; transform: translateY(20px) scale(0.96); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
        .stat-card:hover {
            border-color: var(--border-light); background: var(--bg-card-hover);
            transform: translateY(-4px); box-shadow: var(--card-shadow);
        }
        .stat-card::after {
            content: ''; position: absolute; top: 0; right: 0;
            width: 80px; height: 80px; border-radius: 50%;
            filter: blur(40px); opacity: 0; transition: opacity 0.35s ease;
        }
        .stat-card:hover::after { opacity: 1; }
        .stat-card.green::after { background: var(--accent); }
        .stat-card.amber::after { background: var(--accent-warm); }
        .stat-card.teal::after { background: #14b8a6; }
        .stat-card.rose::after { background: #f43f5e; }
        .stat-icon {
            width: 42px; height: 42px; border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 17px; margin-bottom: 16px;
        }
        .stat-card.green .stat-icon { background: rgba(0, 201, 120, 0.12); color: var(--accent); }
        .stat-card.amber .stat-icon { background: rgba(240, 168, 48, 0.12); color: var(--accent-warm); }
        .stat-card.teal .stat-icon { background: rgba(20, 184, 166, 0.12); color: #14b8a6; }
        .stat-card.rose .stat-icon { background: rgba(244, 63, 94, 0.12); color: #f43f5e; }
        .stat-label { font-size: 13px; color: var(--fg-muted); margin-bottom: 6px; font-weight: 500; }
        .stat-value {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 32px; font-weight: 700;
            letter-spacing: -1px; line-height: 1;
        }
        .stat-trend {
            display: inline-flex; align-items: center; gap: 4px;
            margin-top: 10px; font-size: 12px; font-weight: 600;
            padding: 3px 8px; border-radius: 6px;
        }
        .stat-trend.up { color: var(--accent); background: rgba(0, 201, 120, 0.1); }
        .stat-trend.down { color: #f43f5e; background: rgba(244, 63, 94, 0.1); }
        .mini-chart {
            position: absolute; bottom: 12px; right: 16px;
            display: flex; align-items: flex-end; gap: 3px;
            opacity: 0.3; transition: opacity 0.3s ease;
        }
        .stat-card:hover .mini-chart { opacity: 0.6; }
        .mini-bar { width: 4px; border-radius: 2px; animation: barGrow 1.2s ease both; }
        @@keyframes barGrow { from { height: 0; } }
        .stat-card.green .mini-bar { background: var(--accent); }
        .stat-card.amber .mini-bar { background: var(--accent-warm); }
        .stat-card.teal .mini-bar { background: #14b8a6; }
        .stat-card.rose .mini-bar { background: #f43f5e; }

        .login-panel {
            width: 400px; flex-shrink: 0;
            animation: slideInRight 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
        }
        @@keyframes slideInRight {
            from { opacity: 0; transform: translateX(40px); }
            to { opacity: 1; transform: translateX(0); }
        }
        .login-card {
            background: var(--glass); border: 1px solid var(--border);
            border-radius: 24px; padding: 44px 40px;
            backdrop-filter: blur(30px); -webkit-backdrop-filter: blur(30px);
            box-shadow: 0 0 0 1px rgba(0,201,120,0.03),
                        0 20px 60px rgba(0,0,0,0.5),
                        0 0 120px rgba(0,201,120,0.03);
            position: relative; overflow: hidden;
        }
        .login-card::before {
            content: ''; position: absolute; top: 0; left: 0; right: 0;
            height: 2px; background: linear-gradient(90deg, transparent, var(--accent), transparent);
            opacity: 0.5;
        }
        .login-welcome { margin-bottom: 36px; }
        .login-welcome h1 {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 26px; font-weight: 700;
            letter-spacing: -0.5px; margin-bottom: 8px;
        }
        .login-welcome p { font-size: 14px; color: var(--fg-muted); line-height: 1.5; }
        .form-group { margin-bottom: 22px; position: relative; }
        .form-label {
            display: block; font-size: 13px; font-weight: 600;
            color: var(--fg-muted); margin-bottom: 8px;
            letter-spacing: 0.3px; text-transform: uppercase;
        }
        .input-wrapper { position: relative; }
        .input-wrapper i.input-icon {
            position: absolute; left: 16px; top: 50%;
            transform: translateY(-50%);
            color: var(--fg-dim); font-size: 15px;
            transition: color 0.25s ease; pointer-events: none;
        }
        .form-input {
            width: 100%; padding: 14px 16px 14px 46px;
            background: var(--bg-deep); border: 1.5px solid var(--border);
            border-radius: 12px; color: var(--fg); font-size: 15px;
            font-family: 'DM Sans', sans-serif; outline: none;
            transition: all 0.3s ease;
        }
        .form-input::placeholder { color: var(--fg-dim); }
        .form-input:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-glow), 0 0 20px var(--accent-glow);
        }
        .input-wrapper:focus-within i.input-icon { color: var(--accent); }
        .toggle-password {
            position: absolute; right: 14px; top: 50%;
            transform: translateY(-50%);
            background: none; border: none; color: var(--fg-dim);
            cursor: pointer; font-size: 15px; padding: 4px;
            transition: color 0.25s ease; display: flex; align-items: center;
        }
        .toggle-password:hover { color: var(--accent); }
        .form-meta {
            display: flex; align-items: center; justify-content: space-between;
            margin-bottom: 28px;
        }
        .checkbox-wrapper {
            display: flex; align-items: center; gap: 10px;
            cursor: pointer; user-select: none;
        }
        .custom-checkbox {
            width: 18px; height: 18px; border: 1.5px solid var(--border-light);
            border-radius: 5px; display: flex; align-items: center; justify-content: center;
            transition: all 0.25s ease; flex-shrink: 0; background: var(--bg-deep);
        }
        .custom-checkbox.checked { background: var(--accent); border-color: var(--accent); }
        .custom-checkbox i {
            font-size: 10px; color: #000; opacity: 0;
            transform: scale(0); transition: all 0.2s ease;
        }
        .custom-checkbox.checked i { opacity: 1; transform: scale(1); }
        .checkbox-label { font-size: 13px; color: var(--fg-muted); }
        .forgot-link {
            font-size: 13px; color: var(--accent); text-decoration: none;
            font-weight: 500; transition: all 0.2s ease; position: relative;
        }
        .forgot-link::after {
            content: ''; position: absolute; bottom: -2px; left: 0;
            width: 0; height: 1px; background: var(--accent);
            transition: width 0.3s ease;
        }
        .forgot-link:hover::after { width: 100%; }
        .login-btn {
            width: 100%; padding: 15px;
            background: linear-gradient(135deg, var(--accent), #008f55);
            border: none; border-radius: 12px; color: #000;
            font-size: 15px; font-weight: 700; font-family: 'DM Sans', sans-serif;
            cursor: pointer; transition: all 0.3s ease;
            position: relative; overflow: hidden; letter-spacing: 0.3px;
        }
        .login-btn::before {
            content: ''; position: absolute; inset: 0;
            background: linear-gradient(135deg, transparent 30%, rgba(255,255,255,0.2) 50%, transparent 70%);
            transform: translateX(-100%); transition: transform 0.6s ease;
        }
        .login-btn:hover {
            box-shadow: 0 4px 24px rgba(0, 201, 120, 0.35), 0 0 60px rgba(0, 201, 120, 0.1);
            transform: translateY(-2px);
        }
        .login-btn:hover::before { transform: translateX(100%); }
        .login-btn:active { transform: translateY(0); }
        .version-tag {
            text-align: center; margin-top: 24px;
            font-size: 12px; color: var(--fg-dim); letter-spacing: 0.5px;
        }
        .field-error {
            color: #f43f5e; font-size: 12px; margin-top: 6px;
            display: block;
        }
        .toast-container {
            position: fixed; top: 80px; right: 24px; z-index: 1000;
            display: flex; flex-direction: column; gap: 10px;
        }
        .toast {
            background: var(--bg-card); border: 1px solid var(--border);
            border-radius: 12px; padding: 14px 20px;
            display: flex; align-items: center; gap: 12px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.5);
            animation: toastIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
            min-width: 280px; backdrop-filter: blur(20px);
        }
        .toast.leaving { animation: toastOut 0.3s ease both; }
        @@keyframes toastIn {
            from { opacity: 0; transform: translateX(30px) scale(0.95); }
            to { opacity: 1; transform: translateX(0) scale(1); }
        }
        @@keyframes toastOut { to { opacity: 0; transform: translateX(30px) scale(0.95); } }
        .toast-icon {
            width: 32px; height: 32px; border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            font-size: 14px; flex-shrink: 0;
        }
        .toast.success .toast-icon { background: rgba(0,201,120,0.15); color: var(--accent); }
        .toast.error .toast-icon { background: rgba(244,63,94,0.15); color: #f43f5e; }
        .toast.info .toast-icon { background: rgba(240,168,48,0.15); color: var(--accent-warm); }
        .toast.warning .toast-icon { background: rgba(240,168,48,0.15); color: var(--accent-warm); }
        .toast-text { font-size: 13px; color: var(--fg); font-weight: 500; }
        .footer {
            position: relative; z-index: 10;
            display: flex; align-items: center; justify-content: space-between;
            padding: 14px 40px; border-top: 1px solid var(--border);
            background: rgba(10, 15, 13, 0.8);
            backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
        }
        .footer-left { font-size: 12px; color: var(--fg-dim); }
        .footer-right { font-size: 12px; color: var(--fg-dim); display: flex; align-items: center; gap: 6px; }
        .footer-right .dot {
            width: 6px; height: 6px; border-radius: 50%;
            background: var(--accent); animation: dotPulse 2s ease-in-out infinite;
        }
        @@keyframes dotPulse { 0%, 100% { opacity: 0.4; } 50% { opacity: 1; } }
        .btn-spinner {
            display: inline-block; width: 18px; height: 18px;
            border: 2.5px solid rgba(0,0,0,0.2); border-top-color: #000;
            border-radius: 50%; animation: spin 0.7s linear infinite;
            vertical-align: middle;
        }
        @@keyframes spin { to { transform: rotate(360deg); } }
        .lang-dropdown { position: relative; }
        .lang-menu {
            position: absolute; top: calc(100% + 8px); right: 0;
            background: var(--bg-card); border: 1px solid var(--border);
            border-radius: 12px; padding: 6px; min-width: 140px;
            box-shadow: 0 16px 48px rgba(0,0,0,0.5);
            opacity: 0; visibility: hidden; transform: translateY(-8px);
            transition: all 0.25s ease; z-index: 100;
        }
        .lang-menu.open { opacity: 1; visibility: visible; transform: translateY(0); }
        .lang-option {
            display: flex; align-items: center; gap: 10px;
            padding: 9px 14px; border-radius: 8px; font-size: 13px;
            color: var(--fg-muted); cursor: pointer; transition: all 0.2s ease;
            border: none; background: none; width: 100%; font-family: 'DM Sans', sans-serif;
        }
        .lang-option:hover { background: var(--accent-glow); color: var(--accent); }
        .lang-option.active { color: var(--accent); }
        @@keyframes shake {
            0%, 100% { transform: translateX(0); }
            20% { transform: translateX(-8px); }
            40% { transform: translateX(8px); }
            60% { transform: translateX(-4px); }
            80% { transform: translateX(4px); }
        }
        .shake { animation: shake 0.4s ease; }
        @@media (max-width: 960px) {
            .main-content { flex-direction: column; gap: 40px; padding: 24px; overflow-y: auto; }
            .dashboard-preview { max-width: 100%; }
            .login-panel { width: 100%; max-width: 400px; }
            .stats-grid { grid-template-columns: 1fr 1fr; }
        }
        @@media (max-width: 500px) {
            .topbar { padding: 12px 16px; }
            .footer { padding: 12px 16px; flex-direction: column; gap: 6px; }
            .login-card { padding: 32px 24px; }
            .stats-grid { grid-template-columns: 1fr; }
            .topbar-title { font-size: 14px; }
        }
        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>
</head>
<body>

    <div class="bg-layer"></div>
    <div class="grid-pattern"></div>
    <div class="particles" id="particles"></div>

    <header class="topbar">
        <div class="topbar-left">
            <div class="topbar-logo"><i class="fas fa-warehouse" style="font-size:15px"></i></div>
            <span class="topbar-title">Inventory Management System</span>
        </div>
        <div class="topbar-right">
            <div class="lang-dropdown">
                <button class="topbar-btn active" id="langBtn" aria-haspopup="true" aria-expanded="false">
                    <i class="fas fa-globe" style="font-size:12px"></i> EN <i class="fas fa-chevron-down" style="font-size:9px;margin-left:2px"></i>
                </button>
                <div class="lang-menu" id="langMenu" role="menu">
                    <button class="lang-option active" role="menuitem" data-lang="EN">English</button>
                    <button class="lang-option" role="menuitem" data-lang="ES">Espa&ntilde;ol</button>
                    <button class="lang-option" role="menuitem" data-lang="FR">Fran&ccedil;ais</button>
                    <button class="lang-option" role="menuitem" data-lang="DE">Deutsch</button>
                    <button class="lang-option" role="menuitem" data-lang="ZH">&#20013;&#25991;</button>
                </div>
            </div>
            <button class="topbar-btn" id="supportBtn">
                <i class="fas fa-headset" style="font-size:12px"></i> Support
            </button>
            <span class="topbar-sun" aria-hidden="true"><i class="fas fa-sun"></i></span>
        </div>
    </header>

    <main class="main-content">
        <section class="dashboard-preview" aria-label="Dashboard statistics preview">
            <div class="preview-header">
                <i class="fas fa-chart-line"></i>
                <h2>Warehouse Dashboard <span>Preview</span></h2>
            </div>
            <div class="stats-grid">
                <div class="stat-card green">
                    <div class="stat-icon"><i class="fas fa-boxes-stacked"></i></div>
                    <div class="stat-label">Products</div>
                    <div class="stat-value" data-target="1250">0</div>
                    <div class="stat-trend up"><i class="fas fa-arrow-up" style="font-size:10px"></i> 12.5%</div>
                    <div class="mini-chart">
                        <div class="mini-bar" style="height:12px;animation-delay:0.8s"></div>
                        <div class="mini-bar" style="height:18px;animation-delay:0.9s"></div>
                        <div class="mini-bar" style="height:14px;animation-delay:1.0s"></div>
                        <div class="mini-bar" style="height:22px;animation-delay:1.1s"></div>
                        <div class="mini-bar" style="height:28px;animation-delay:1.2s"></div>
                        <div class="mini-bar" style="height:24px;animation-delay:1.3s"></div>
                    </div>
                </div>
                <div class="stat-card amber">
                    <div class="stat-icon"><i class="fas fa-warehouse"></i></div>
                    <div class="stat-label">Warehouse</div>
                    <div class="stat-value" data-target="12">0</div>
                    <div class="stat-trend up"><i class="fas fa-arrow-up" style="font-size:10px"></i> 3.2%</div>
                    <div class="mini-chart">
                        <div class="mini-bar" style="height:20px;animation-delay:0.85s"></div>
                        <div class="mini-bar" style="height:20px;animation-delay:0.95s"></div>
                        <div class="mini-bar" style="height:24px;animation-delay:1.05s"></div>
                        <div class="mini-bar" style="height:22px;animation-delay:1.15s"></div>
                        <div class="mini-bar" style="height:26px;animation-delay:1.25s"></div>
                        <div class="mini-bar" style="height:28px;animation-delay:1.35s"></div>
                    </div>
                </div>
                <div class="stat-card teal">
                    <div class="stat-icon"><i class="fas fa-truck-field"></i></div>
                    <div class="stat-label">Suppliers</div>
                    <div class="stat-value" data-target="84">0</div>
                    <div class="stat-trend up"><i class="fas fa-arrow-up" style="font-size:10px"></i> 8.1%</div>
                    <div class="mini-chart">
                        <div class="mini-bar" style="height:16px;animation-delay:0.9s"></div>
                        <div class="mini-bar" style="height:22px;animation-delay:1.0s"></div>
                        <div class="mini-bar" style="height:18px;animation-delay:1.1s"></div>
                        <div class="mini-bar" style="height:26px;animation-delay:1.2s"></div>
                        <div class="mini-bar" style="height:20px;animation-delay:1.3s"></div>
                        <div class="mini-bar" style="height:30px;animation-delay:1.4s"></div>
                    </div>
                </div>
                <div class="stat-card rose">
                    <div class="stat-icon"><i class="fas fa-clipboard-list"></i></div>
                    <div class="stat-label">Orders</div>
                    <div class="stat-value" data-target="520">0</div>
                    <div class="stat-trend down"><i class="fas fa-arrow-down" style="font-size:10px"></i> 2.4%</div>
                    <div class="mini-chart">
                        <div class="mini-bar" style="height:28px;animation-delay:0.95s"></div>
                        <div class="mini-bar" style="height:24px;animation-delay:1.05s"></div>
                        <div class="mini-bar" style="height:20px;animation-delay:1.15s"></div>
                        <div class="mini-bar" style="height:22px;animation-delay:1.25s"></div>
                        <div class="mini-bar" style="height:16px;animation-delay:1.35s"></div>
                        <div class="mini-bar" style="height:18px;animation-delay:1.45s"></div>
                    </div>
                </div>
            </div>
        </section>

        <section class="login-panel" aria-label="Login form">
            <div class="login-card">
                <div class="login-welcome">
                    <h1>Welcome Back</h1>
                    <p>Sign in to access your warehouse dashboard and manage inventory.</p>
                </div>

                <form asp-action="Login" asp-controller="Account" method="post" id="loginForm" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="form-group">
                        <label class="form-label" asp-for="Email">Email</label>
                        <div class="input-wrapper">
                            <i class="fas fa-user input-icon"></i>
                            <input type="text" class="form-input" asp-for="Email"
                                   placeholder="Enter your email"
                                   autocomplete="username" required />
                        </div>
                        @if (ViewData.ModelState["Email"]?.Errors.Count > 0)
                        {
                            <span class="field-error">@ViewData.ModelState["Email"].Errors[0].ErrorMessage</span>
                        }
                    </div>

                    <div class="form-group">
                        <label class="form-label" asp-for="Password">Password</label>
                        <div class="input-wrapper">
                            <i class="fas fa-lock input-icon"></i>
                            <input type="password" class="form-input" asp-for="Password"
                                   placeholder="Enter your password"
                                   autocomplete="current-password" required
                                   style="padding-right: 48px;" />
                            <button type="button" class="toggle-password" id="togglePwd" aria-label="Toggle password visibility">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                        @if (ViewData.ModelState["Password"]?.Errors.Count > 0)
                        {
                            <span class="field-error">@ViewData.ModelState["Password"].Errors[0].ErrorMessage</span>
                        }
                    </div>

                    <div class="form-meta">
                        <div class="checkbox-wrapper" id="rememberWrapper" role="checkbox" aria-checked="false" tabindex="0">
                            <div class="custom-checkbox" id="rememberCheck">
                                <i class="fas fa-check"></i>
                            </div>
                            <span class="checkbox-label">Remember Me</span>
                        </div>
                        <a href="#" class="forgot-link" id="forgotLink">Forgot Password</a>
                    </div>

                    <button type="submit" class="login-btn" id="loginBtn">Sign In</button>
                </form>
                <div class="version-tag">Version 2.5</div>
            </div>
        </section>
    </main>

    <footer class="footer">
        <div class="footer-left">&copy; 2026 Inventory ERP</div>
        <div class="footer-right">
            <span class="dot"></span>
            Powered by Your Company
        </div>
    </footer>

    <div class="toast-container" id="toastContainer" aria-live="polite"></div>

    <script>
        // ---- Particles ----
        (function initParticles() {
            const container = document.getElementById('particles');
            const count = 18;
            for (let i = 0; i < count; i++) {
                const p = document.createElement('div');
                p.classList.add('particle');
                p.style.left = Math.random() * 100 + '%';
                p.style.animationDuration = (8 + Math.random() * 14) + 's';
                p.style.animationDelay = (Math.random() * 10) + 's';
                p.style.width = p.style.height = (2 + Math.random() * 3) + 'px';
                if (Math.random() > 0.6) p.style.background = 'var(--accent-warm)';
                container.appendChild(p);
            }
        })();

        // ---- Counter animation ----
        (function animateCounters() {
            const counters = document.querySelectorAll('.stat-value[data-target]');
            const duration = 1600;
            const startTime = 600;
            counters.forEach(counter => {
                const target = parseInt(counter.dataset.target, 10);
                const start = performance.now() + startTime;
                function update(now) {
                    const elapsed = now - start;
                    if (elapsed < 0) { requestAnimationFrame(update); return; }
                    const progress = Math.min(elapsed / duration, 1);
                    const ease = 1 - Math.pow(1 - progress, 3);
                    counter.textContent = Math.round(target * ease).toLocaleString();
                    if (progress < 1) requestAnimationFrame(update);
                }
                requestAnimationFrame(update);
            });
        })();

        // ---- Toast ----
        function showToast(message, type) {
            type = type || 'info';
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = 'toast ' + type;
            const iconMap = { success: 'fa-check', error: 'fa-xmark', info: 'fa-info', warning: 'fa-triangle-exclamation' };
            toast.innerHTML =
                '<div class="toast-icon"><i class="fas ' + (iconMap[type] || 'fa-info') + '"></i></div>' +
                '<span class="toast-text">' + message + '</span>';
            container.appendChild(toast);
            setTimeout(function () {
                toast.classList.add('leaving');
                setTimeout(function () { toast.remove(); }, 300);
            }, 4000);
        }

        // ---- Show TempData alert on page load ----
        @if (!string.IsNullOrEmpty(alertMessage))
        {
            <text>
            (function () {
                showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(alertMessage)),
                          @Html.Raw(System.Text.Json.JsonSerializer.Serialize(alertType ?? "info")));
            })();
            </text>
        }

        // ---- Toggle password visibility ----
        (function () {
            var toggleBtn = document.getElementById('togglePwd');
            var pwdInput = document.getElementById('Password') || document.querySelector('input[name="Password"]');
            if (!toggleBtn || !pwdInput) return;
            toggleBtn.addEventListener('click', function () {
                var isPassword = pwdInput.type === 'password';
                pwdInput.type = isPassword ? 'text' : 'password';
                toggleBtn.querySelector('i').className = isPassword ? 'fas fa-eye-slash' : 'fas fa-eye';
            });
        })();

        // ---- Remember me (visual only) ----
        (function () {
            var wrapper = document.getElementById('rememberWrapper');
            var box = document.getElementById('rememberCheck');
            if (!wrapper || !box) return;
            var checked = false;
            function toggle() {
                checked = !checked;
                box.classList.toggle('checked', checked);
                wrapper.setAttribute('aria-checked', checked);
            }
            wrapper.addEventListener('click', toggle);
            wrapper.addEventListener('keydown', function (e) {
                if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); toggle(); }
            });
        })();

        // ---- Language dropdown ----
        (function () {
            var btn = document.getElementById('langBtn');
            var menu = document.getElementById('langMenu');
            if (!btn || !menu) return;
            var options = menu.querySelectorAll('.lang-option');
            var isOpen = false;
            function toggleMenu() {
                isOpen = !isOpen;
                menu.classList.toggle('open', isOpen);
                btn.setAttribute('aria-expanded', isOpen);
            }
            btn.addEventListener('click', function (e) { e.stopPropagation(); toggleMenu(); });
            options.forEach(function (opt) {
                opt.addEventListener('click', function () {
                    var lang = this.dataset.lang;
                    options.forEach(function (o) { o.classList.remove('active'); });
                    this.classList.add('active');
                    btn.innerHTML = '<i class="fas fa-globe" style="font-size:12px"></i> ' + lang + ' <i class="fas fa-chevron-down" style="font-size:9px;margin-left:2px"></i>';
                    toggleMenu();
                    showToast('Language switched to ' + this.textContent.trim(), 'info');
                });
            });
            document.addEventListener('click', function (e) {
                if (isOpen && !menu.contains(e.target) && e.target !== btn) toggleMenu();
            });
        })();

        document.getElementById('supportBtn').addEventListener('click', function () {
            showToast('Support channel is available Mon-Fri, 9:00-18:00', 'info');
        });

        document.getElementById('forgotLink').addEventListener('click', function (e) {
            e.preventDefault();
            showToast('Password reset link sent to your registered email', 'success');
        });

        // ---- Form submit -> POST to Account/Login with loading state ----
        (function () {
            var form = document.getElementById('loginForm');
            var loginBtn = document.getElementById('loginBtn');
            var emailInput = document.getElementById('Email');
            var passwordInput = document.getElementById('Password');

            form.addEventListener('submit', function (e) {
                var user = (emailInput.value || '').trim();
                var pass = passwordInput.value;

                if (!user) {
                    e.preventDefault();
                    emailInput.parentElement.classList.add('shake');
                    emailInput.focus();
                    showToast('Please enter your email', 'error');
                    setTimeout(function () { emailInput.parentElement.classList.remove('shake'); }, 500);
                    return;
                }
                if (!pass) {
                    e.preventDefault();
                    passwordInput.parentElement.classList.add('shake');
                    passwordInput.focus();
                    showToast('Please enter your password', 'error');
                    setTimeout(function () { passwordInput.parentElement.classList.remove('shake'); }, 500);
                    return;
                }

                // Show loading state, then allow the actual POST to continue
                loginBtn.disabled = true;
                loginBtn.innerHTML = '<span class="btn-spinner"></span> Signing in...';
            });

            [emailInput, passwordInput].forEach(function (input) {
                if (!input) return;
                input.addEventListener('input', function () {
                    this.parentElement.classList.remove('shake');
                });
            });
        })();

        // ---- Stat cards tilt ----
        (function () {
            var cards = document.querySelectorAll('.stat-card');
            cards.forEach(function (card) {
                card.addEventListener('mousemove', function (e) {
                    var rect = card.getBoundingClientRect();
                    var x = e.clientX - rect.left;
                    var y = e.clientY - rect.top;
                    var centerX = rect.width / 2;
                    var centerY = rect.height / 2;
                    var rotateX = (y - centerY) / centerY * -4;
                    var rotateY = (x - centerX) / centerX * 4;
                    card.style.transform = 'translateY(-4px) perspective(600px) rotateX(' + rotateX + 'deg) rotateY(' + rotateY + 'deg)';
                });
                card.addEventListener('mouseleave', function () { card.style.transform = ''; });
            });
        })();
    </script>
</body>
</html>