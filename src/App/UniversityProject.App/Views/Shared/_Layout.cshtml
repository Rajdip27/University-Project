@using Microsoft.AspNetCore.Identity
@inject SignInManager<UniversityProject.Core.Entities.Auth.IdentityModel.User> SignInManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Inventory ERP</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
   
    @await RenderSectionAsync("Styles", required: false)

    <style>
        :root {
            --bg-deep: #0a0f0d;
            --bg-panel: #111a16;
            --bg-card: #162019;
            --bg-card-hover: #1c2b22;
            --fg: #e8efe9;
            --fg-muted: #7a9484;
            --fg-dim: #4a6a56;
            --accent: #00c978;
            --accent-glow: rgba(0, 201, 120, 0.15);
            --accent-warm: #f0a830;
            --accent-warm-glow: rgba(240, 168, 48, 0.12);
            --border: #1e3028;
            --border-light: #253a2e;
            --card-shadow: 0 4px 24px rgba(0,0,0,0.4);
            --glass: rgba(16, 28, 22, 0.85);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--bg-deep);
            color: var(--fg);
            min-height: 100vh;
            display: flex;
            overflow: hidden;
            position: relative;
        }

        /* Background layers */
        .bg-layer { position: fixed; inset: 0; z-index: 0; overflow: hidden; }
        .bg-layer::before {
            content: ''; position: absolute; top: -30%; left: -20%;
            width: 70vw; height: 70vw;
            background: radial-gradient(circle, rgba(0,201,120,0.06) 0%, transparent 65%);
            animation: drift1 20s ease-in-out infinite;
        }
        .bg-layer::after {
            content: ''; position: absolute; bottom: -20%; right: -15%;
            width: 55vw; height: 55vw;
            background: radial-gradient(circle, rgba(240,168,48,0.04) 0%, transparent 60%);
            animation: drift2 25s ease-in-out infinite;
        }
        @@keyframes drift1 {
            0%, 100% { transform: translate(0, 0) scale(1); }
            33% { transform: translate(8%, 5%) scale(1.05); }
            66% { transform: translate(-3%, -4%) scale(0.97); }
        }
        @@keyframes drift2 {
            0%, 100% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(-6%, -8%) scale(1.08); }
        }

        .grid-pattern {
            position: fixed; inset: 0; z-index: 0;
            background-image: linear-gradient(rgba(0,201,120,0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(0,201,120,0.02) 1px, transparent 1px);
            background-size: 60px 60px;
            mask-image: radial-gradient(ellipse at 50% 50%, black 30%, transparent 80%);
        }

        /* Layout */
        .app-layout { display: flex; width: 100%; height: 100vh; position: relative; z-index: 1; }

        /* Sidebar */
        .sidebar {
            width: 260px; flex-shrink: 0;
            background: rgba(10, 15, 13, 0.6);
            backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
            border-right: 1px solid var(--border);
            display: flex; flex-direction: column;
            padding: 24px 16px;
            transition: transform 0.3s ease;
        }
        .sidebar-logo {
            display: flex; align-items: center; gap: 12px;
            padding: 0 12px 24px 12px;
            border-bottom: 1px solid var(--border);
            margin-bottom: 24px;
        }
        .logo-icon {
            width: 36px; height: 36px;
            background: linear-gradient(135deg, var(--accent), #008f55);
            border-radius: 10px; display: flex; align-items: center; justify-content: center;
            font-size: 16px; color: #000; font-weight: 800;
            box-shadow: 0 0 20px var(--accent-glow);
        }
        .logo-text { font-family: 'Space Grotesk', sans-serif; font-size: 16px; font-weight: 700; letter-spacing: -0.3px; }

        .nav-section { margin-bottom: 24px; }
        .nav-title { font-size: 11px; text-transform: uppercase; color: var(--fg-dim); letter-spacing: 1px; margin-bottom: 12px; padding: 0 12px; }
        .nav-item {
            display: flex; align-items: center; gap: 12px;
            padding: 11px 12px; border-radius: 10px;
            color: var(--fg-muted); text-decoration: none;
            font-size: 14px; font-weight: 500; margin-bottom: 4px;
            transition: all 0.25s ease; position: relative;
        }
        .nav-item:hover { background: var(--bg-card); color: var(--fg); }
        .nav-item.active { background: var(--accent-glow); color: var(--accent); }
        .nav-item.active::before { content: ''; position: absolute; left: 0; top: 20%; bottom: 20%; width: 3px; background: var(--accent); border-radius: 0 4px 4px 0; }
        .nav-item i { width: 20px; text-align: center; font-size: 15px; }

        /* Main Area */
        .main-area { flex: 1; display: flex; flex-direction: column; overflow: hidden; }

        /* Topbar */
        .topbar {
            display: flex; align-items: center; justify-content: space-between;
            padding: 16px 32px; border-bottom: 1px solid var(--border);
            background: rgba(10, 15, 13, 0.7);
            backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
        }
        .topbar-search { position: relative; width: 320px; }
        .topbar-search input {
            width: 100%; padding: 10px 14px 10px 40px;
            background: var(--bg-deep); border: 1px solid var(--border);
            border-radius: 10px; color: var(--fg); font-size: 13px;
            font-family: 'DM Sans', sans-serif; outline: none; transition: all 0.2s ease;
        }
        .topbar-search input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-glow); }
        .topbar-search i { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--fg-dim); font-size: 13px; }

        .topbar-right { display: flex; align-items: center; gap: 16px; }
        .topbar-btn-icon {
            width: 38px; height: 38px; border-radius: 10px;
            background: var(--bg-deep); border: 1px solid var(--border);
            color: var(--fg-muted); cursor: pointer; display: flex;
            align-items: center; justify-content: center; transition: all 0.2s ease; position: relative;
        }
        .topbar-btn-icon:hover { border-color: var(--accent); color: var(--accent); }
        .badge-dot { position: absolute; top: 8px; right: 8px; width: 8px; height: 8px; background: var(--accent-warm); border-radius: 50%; border: 2px solid var(--bg-deep); }
        
        .profile-chip {
            display: flex; align-items: center; gap: 10px;
            padding: 6px 12px 6px 6px; background: var(--bg-deep);
            border: 1px solid var(--border); border-radius: 12px;
            cursor: pointer; transition: all 0.2s ease;
        }
        .profile-chip:hover { border-color: var(--accent); }
        .profile-avatar {
            width: 30px; height: 30px; border-radius: 8px;
            background: linear-gradient(135deg, #f0a830, #d97d1c);
            display: flex; align-items: center; justify-content: center;
            font-weight: 700; font-size: 13px; color: #000;
        }
        .profile-name { font-size: 13px; font-weight: 600; color: var(--fg); }

        /* Content Container */
        .content { flex: 1; overflow-y: auto; padding: 32px; }
        .page-header { margin-bottom: 28px; }
        .page-header h1 { font-family: 'Space Grotesk', sans-serif; font-size: 28px; font-weight: 700; letter-spacing: -0.5px; margin-bottom: 6px; }
        .page-header p { color: var(--fg-muted); font-size: 14px; }

        /* CARDS & GRIDS */
        .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 24px; }
        .stat-card {
            background: var(--bg-card); border: 1px solid var(--border);
            border-radius: 16px; padding: 24px; position: relative;
            overflow: hidden; transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .stat-card:hover { border-color: var(--border-light); transform: translateY(-4px); box-shadow: var(--card-shadow); }
        .stat-card::after {
            content: ''; position: absolute; top: 0; right: 0; width: 80px; height: 80px;
            border-radius: 50%; filter: blur(40px); opacity: 0; transition: opacity 0.35s ease;
        }
        .stat-card:hover::after { opacity: 1; }
        .stat-card.green::after { background: var(--accent); }
        .stat-card.amber::after { background: var(--accent-warm); }
        .stat-card.teal::after { background: #14b8a6; }
        .stat-card.rose::after { background: #f43f5e; }

        .stat-icon { width: 42px; height: 42px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 17px; margin-bottom: 16px; }
        .stat-card.green .stat-icon { background: rgba(0, 201, 120, 0.12); color: var(--accent); }
        .stat-card.amber .stat-icon { background: rgba(240, 168, 48, 0.12); color: var(--accent-warm); }
        .stat-card.teal .stat-icon { background: rgba(20, 184, 166, 0.12); color: #14b8a6; }
        .stat-card.rose .stat-icon { background: rgba(244, 63, 94, 0.12); color: #f43f5e; }

        .stat-label { font-size: 13px; color: var(--fg-muted); margin-bottom: 6px; font-weight: 500; }
        .stat-value { font-family: 'Space Grotesk', sans-serif; font-size: 32px; font-weight: 700; letter-spacing: -1px; line-height: 1; }
        .stat-trend { display: inline-flex; align-items: center; gap: 4px; margin-top: 10px; font-size: 12px; font-weight: 600; padding: 3px 8px; border-radius: 6px; }
        .stat-trend.up { color: var(--accent); background: rgba(0, 201, 120, 0.1); }
        .stat-trend.down { color: #f43f5e; background: rgba(244, 63, 94, 0.1); }

        /* PANELS & TABLES */
        .content-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 20px; }
        .panel {
            background: var(--glass); border: 1px solid var(--border);
            border-radius: 16px; padding: 24px;
            backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
            min-width: 0; 
            overflow: hidden; 
        }
        .panel-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; gap: 15px; }
        .panel-header h3 { font-family: 'Space Grotesk', sans-serif; font-size: 18px; font-weight: 600; }
        .panel-action { font-size: 12px; color: var(--accent); text-decoration: none; font-weight: 600; padding: 6px 12px; border-radius: 6px; transition: all 0.2s ease; white-space: nowrap; }
        .panel-action:hover { background: var(--accent-glow); }

        .table-wrapper { overflow-x: auto; max-width: 100%; -webkit-overflow-scrolling: touch; }
        table { width: 100%; border-collapse: collapse; min-width: 320px; }
        thead th {
            text-align: left; padding: 12px 16px; font-size: 12px;
            color: var(--fg-muted); text-transform: uppercase; letter-spacing: 0.5px;
            border-bottom: 1px solid var(--border); font-weight: 600;
            white-space: nowrap;
        }
        tbody td { padding: 14px 16px; font-size: 14px; border-bottom: 1px solid var(--border); color: var(--fg); white-space: nowrap; }
        tbody tr:last-child td { border-bottom: none; }
        tbody tr { transition: background 0.2s ease; }
        tbody tr:hover { background: rgba(255,255,255,0.02); }
        
        .status-badge { padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; }
        .status-badge::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
        .status-badge.delivered, .status-badge.active { color: var(--accent); background: rgba(0, 201, 120, 0.1); }
        .status-badge.pending, .status-badge.inactive { color: var(--accent-warm); background: rgba(240, 168, 48, 0.1); }
        .status-badge.shipped { color: #14b8a6; background: rgba(20, 184, 166, 0.1); }

        /* Logout button */
        .logout-btn {
            background: transparent; border: 1px solid #f43f5e;
            color: #f43f5e; padding: 7px 14px; border-radius: 8px;
            font-size: 13px; font-family: 'DM Sans', sans-serif; cursor: pointer;
            transition: all 0.25s ease; display: flex; align-items: center; gap: 6px;
        }
        .logout-btn:hover { background: rgba(244, 63, 94, 0.1); }

        /* Toast */
        .toast-container { position: fixed; top: 24px; right: 24px; z-index: 1000; display: flex; flex-direction: column; gap: 10px; }
        .toast {
            background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px;
            padding: 14px 20px; display: flex; align-items: center; gap: 12px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.5); animation: toastIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
            min-width: 280px; backdrop-filter: blur(20px);
        }
        .toast.leaving { animation: toastOut 0.3s ease both; }
        @@keyframes toastIn { from { opacity: 0; transform: translateX(30px) scale(0.95); } to { opacity: 1; transform: translateX(0) scale(1); } }
        @@keyframes toastOut { to { opacity: 0; transform: translateX(30px) scale(0.95); } }
        .toast-icon { width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 14px; flex-shrink: 0; }
        .toast.success .toast-icon { background: rgba(0,201,120,0.15); color: var(--accent); }
        .toast.error .toast-icon { background: rgba(244,63,94,0.15); color: #f43f5e; }
        .toast.info .toast-icon { background: rgba(240,168,48,0.15); color: var(--accent-warm); }
        .toast-text { font-size: 13px; color: var(--fg); font-weight: 500; }

        /* Custom Modal & Loader Styles */
        .modal-overlay {
            position: fixed; inset: 0; z-index: 2000;
            background: rgba(0, 0, 0, 0.7); backdrop-filter: blur(8px);
            display: flex; align-items: center; justify-content: center;
            opacity: 0; visibility: hidden; transition: all 0.3s ease;
        }
        .modal-overlay.open { opacity: 1; visibility: visible; }

        .modal-content {
            background: var(--bg-card); border: 1px solid var(--border);
            border-radius: 16px; padding: 32px; max-width: 420px; width: 90%;
            text-align: center; box-shadow: 0 20px 60px rgba(0,0,0,0.5);
            transform: scale(0.9); transition: transform 0.3s ease;
        }
        .modal-overlay.open .modal-content { transform: scale(1); }

        .modal-icon {
            width: 64px; height: 64px; border-radius: 50%;
            background: rgba(244, 63, 94, 0.15); color: #f43f5e;
            display: flex; align-items: center; justify-content: center;
            font-size: 24px; margin: 0 auto 20px auto;
        }
        .modal-title { font-family: 'Space Grotesk', sans-serif; font-size: 22px; font-weight: 700; margin-bottom: 10px; }
        .modal-text { color: var(--fg-muted); font-size: 14px; line-height: 1.5; margin-bottom: 28px; }
        .modal-actions { display: flex; gap: 12px; justify-content: center; }

        .btn-danger {
            background: linear-gradient(135deg, #f43f5e, #c1283f);
            color: #fff; border: none; padding: 12px 24px; border-radius: 10px;
            font-weight: 700; font-size: 14px; cursor: pointer;
            display: inline-flex; align-items: center; gap: 8px; transition: all 0.3s;
        }
        .btn-danger:hover { transform: translateY(-2px); box-shadow: 0 4px 20px rgba(244, 63, 94, 0.3); }

        .btn-secondary {
            background: transparent; color: var(--fg-muted); border: 1px solid var(--border);
            padding: 12px 24px; border-radius: 10px; font-weight: 600; font-size: 14px;
            cursor: pointer; display: inline-flex; align-items: center; gap: 8px; transition: all 0.2s;
        }
        .btn-secondary:hover { border-color: var(--fg-muted); color: var(--fg); }

        .btn-spinner {
            display: inline-block; width: 16px; height: 16px;
            border: 2.5px solid rgba(0,0,0,0.2); border-top-color: #000;
            border-radius: 50%; animation: spin 0.7s linear infinite;
            vertical-align: middle; margin-right: 8px;
        }
        @@keyframes spin { to { transform: rotate(360deg); } }

        /* Responsive */
        @@media (max-width: 1024px) {
            .stats-grid { grid-template-columns: repeat(2, 1fr); }
            .content-grid { grid-template-columns: 1fr; }
            .sidebar { position: fixed; left: 0; top: 0; bottom: 0; transform: translateX(-100%); z-index: 100; }
            .sidebar.open { transform: translateX(0); }
        }
        @@media (max-width: 600px) {
            .stats-grid { grid-template-columns: 1fr; }
            .topbar-search { display: none; }
            .content { padding: 20px; }
        }
    </style>
</head>
<body>
    <div class="bg-layer"></div>
    <div class="grid-pattern"></div>

    <div class="app-layout">
        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-logo">
                <div class="logo-icon"><i class="fas fa-warehouse"></i></div>
                <div class="logo-text">Inventory ERP</div>
            </div>
            
            <div class="nav-section">
                <div class="nav-title">Main Menu</div>
                <a asp-controller="Dashboard" asp-action="Index" class="nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "Dashboard" ? "active" : "")">
                    <i class="fas fa-grid-2"></i> Dashboard
                </a>
                <a asp-controller="Products" asp-action="Index" class="nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "Products" ? "active" : "")">
                    <i class="fas fa-boxes-stacked"></i> Products
                </a>
                <a asp-controller="Purchase" asp-action="Index" class="nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "Purchase" ? "active" : "")">
                   <i class="fas fa-file-invoice"></i>  Purchase
                </a>
                <a asp-controller="Supplier" asp-action="Index" class="nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "Supplier" ? "active" : "")">
                    <i class="fas fa-truck-field"></i> Suppliers
                </a>
                <a asp-controller="Orders" asp-action="Index" class="nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "Orders" ? "active" : "")">
                    <i class="fas fa-clipboard-list"></i> Orders
                </a>
            </div>

            <div class="nav-section">
                <div class="nav-title">Management</div>
                <a asp-controller="Customer" asp-action="Index" class="nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "Customer" ? "active" : "")">
                    <i class="fas fa-users"></i> Customers
                </a>
                <a asp-controller="Purchase" asp-action="StockReport" class="nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "Purchase" ? "active" : "")">
                    <i class="fas fa-receipt"></i> Purchase Report
                </a>
                <a asp-controller="Reports" asp-action="Index" class="nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "Reports" ? "active" : "")">
                    <i class="fas fa-chart-pie"></i> Reports
                </a>
                <a asp-controller="Settings" asp-action="Index" class="nav-item @(ViewContext.RouteData.Values["Controller"].ToString() == "Settings" ? "active" : "")">
                    <i class="fas fa-cog"></i> Settings
                </a>
            </div>
        </aside>

        <!-- Main Area -->
        <div class="main-area">
            <!-- Topbar -->
            <header class="topbar">
                <div class="topbar-search">
                    <i class="fas fa-search"></i>
                    <input type="text" placeholder="Search inventory, orders, suppliers...">
                </div>
                
                <div class="topbar-right">
                    <button class="topbar-btn-icon" aria-label="Notifications">
                        <i class="fas fa-bell"></i>
                        <span class="badge-dot"></span>
                    </button>
                    
                    <div class="profile-chip">
                        <div class="profile-avatar">JD</div>
                        <span class="profile-name">John Doe</span>
                        <i class="fas fa-chevron-down" style="font-size: 10px; color: var(--fg-muted);"></i>
                    </div>

                    @if (SignInManager.IsSignedIn(User))
                    {
                        <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
                            <button type="submit" class="logout-btn">
                                <i class="fas fa-right-from-bracket"></i> Logout
                            </button>
                        </form>
                    }
                </div>
            </header>

            <!-- Page Body -->
            <main class="content">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Toast Container -->
    <div class="toast-container" id="toastContainer" aria-live="polite"></div>

    <!-- Custom Confirmation Modal -->
    <div class="modal-overlay" id="confirmModal">
        <div class="modal-content">
            <div class="modal-icon"><i class="fas fa-exclamation-triangle"></i></div>
            <h3 class="modal-title">Are you sure?</h3>
            <p class="modal-text" id="confirmModalText">You won't be able to revert this action. The item will be permanently deleted.</p>
            <div class="modal-actions">
                <button type="button" class="btn-secondary" id="modalCancelBtn">Cancel</button>
                <button type="button" class="btn-danger" id="modalConfirmBtn"><i class="fas fa-trash"></i> Yes, delete it!</button>
            </div>
        </div>
    </div>
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <!-- Select2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        // ---- Toast System ----
        function showToast(message, type) {
            type = type || 'info';
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = 'toast ' + type;
            const iconMap = { success: 'fa-check', error: 'fa-xmark', info: 'fa-info' };
            toast.innerHTML = '<div class="toast-icon"><i class="fas ' + (iconMap[type] || 'fa-info') + '"></i></div><span class="toast-text">' + message + '</span>';
            container.appendChild(toast);
            setTimeout(function() {
                toast.classList.add('leaving');
                setTimeout(function() { toast.remove(); }, 300);
            }, 3500);
        }

        // ---- Display TempData Alerts ----
        @if (TempData["AlertMessage"] != null)
        {
            <text>
            showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["AlertMessage"].ToString())), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["AlertType"]?.ToString() ?? "info")));
            </text>
        }

        // ---- Custom Confirmation & Loader Logic ----
        let activeForm = null;

        // Intercept form submissions
        document.addEventListener('submit', function(e) {
            const form = e.target;
            
            // 1. Handle Delete Confirmation
            if (form.hasAttribute('data-confirm-delete')) {
                e.preventDefault(); // Stop submission temporarily
                activeForm = form;
                document.getElementById('confirmModal').classList.add('open');
            } 
            // 2. Handle Save Loader
            else if (form.hasAttribute('data-loader')) {
                const btn = form.querySelector('button[type="submit"]');
                if (btn) {
                    btn.disabled = true;
                    // Check if it's a green (save) button or danger (delete) button to set spinner color
                    const spinnerColor = btn.classList.contains('btn-danger') ? '#fff' : '#000';
                    btn.innerHTML = '<span class="btn-spinner" style="border-top-color:' + spinnerColor + '"></span> Saving...';
                }
                // Allow the form to submit natively
            }
        });

        // Modal Confirm Button
        document.getElementById('modalConfirmBtn').addEventListener('click', function() {
            if (activeForm) {
                // Remove the attribute so it doesn't trigger the modal again when we submit it
                activeForm.removeAttribute('data-confirm-delete');
                activeForm.submit(); // Programmatically submit the form
                
                // Close modal
                document.getElementById('confirmModal').classList.remove('open');
                
                // Show a mini loader on the confirm button just visually
                this.innerHTML = '<span class="btn-spinner" style="border-top-color:#fff; width:14px; height:14px;"></span> Deleting...';
                setTimeout(() => {
                    this.innerHTML = '<i class="fas fa-trash"></i> Yes, delete it!';
                }, 2000);
            }
        });

        // Modal Cancel Button
        document.getElementById('modalCancelBtn').addEventListener('click', function() {
            document.getElementById('confirmModal').classList.remove('open');
            activeForm = null;
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>