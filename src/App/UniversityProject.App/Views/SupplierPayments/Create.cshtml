@model UniversityProject.Application.ViewModel.SupplierPaymentViewModel
@{
    ViewData["Title"] = "Supplier Payment";
    Layout = "_Layout";
}

<style>
    /* Tells the browser to render native dropdowns in dark mode */
    html, body {
        color-scheme: dark;
    }

    .payment-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .form-label {
        font-size: 13px;
        font-weight: 600;
        color: var(--fg-muted);
        text-transform: uppercase;
    }

    /* Standardized Dark Inputs */
    .form-control {
        width: 100%;
        height: 52px;
        padding: 14px 16px;
        background-color: var(--bg-deep) !important;
        border: 1.5px solid var(--border);
        border-radius: 12px;
        color: var(--fg) !important;
        font-size: 14px;
        outline: none;
        transition: all 0.3s ease;
        box-sizing: border-box;
        font-family: 'DM Sans', sans-serif;
    }

        .form-control:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-glow);
        }

    textarea.form-control {
        height: auto;
        min-height: 100px;
        resize: vertical;
    }

    select.form-control {
        appearance: none;
        -webkit-appearance: none;
        cursor: pointer;
        padding-right: 40px;
        background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%237a9484' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right 16px center;
        background-size: 16px;
    }

        select.form-control option {
            background-color: var(--bg-deep) !important;
            color: var(--fg) !important;
        }

    /* Table Input Overrides */
    .table-wrapper .payment-input {
        height: 42px;
        padding: 10px;
        width: 130px;
        background: var(--bg-deep);
        border: 1px solid var(--border);
        border-radius: 8px;
        color: var(--accent) !important;
        font-weight: 600;
        text-align: right;
    }

        .table-wrapper .payment-input:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 2px var(--accent-glow);
        }

    .payment-summary {
        display: flex;
        justify-content: flex-end;
        margin-top: 20px;
    }

    .summary-box {
        width: 350px;
        background: var(--bg-deep);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 20px;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
        color: var(--fg-muted);
    }

        .summary-row.total {
            border-top: 1px solid var(--border);
            padding-top: 15px;
            font-size: 20px;
            font-weight: 700;
            color: var(--fg);
        }

    .btn-primary {
        background: linear-gradient(135deg, var(--accent), #008f55);
        color: #000;
        border: none;
        padding: 12px 24px;
        border-radius: 10px;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-secondary {
        background: transparent;
        color: var(--fg-muted);
        border: 1px solid var(--border);
        padding: 12px 24px;
        border-radius: 10px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid var(--border);
    }

    @@media (max-width: 768px) {
        .form-grid {
            grid-template-columns: 1fr;
        }

        .summary-box {
            width: 100%;
        }
    }
</style>

<div class="page-header">
    <h1>Supplier Payment</h1>
    <p>Select a supplier and enter payment against unpaid purchases.</p>
</div>

<div class="panel payment-container">
    <!-- Added data-loader for the save spinner -->
    <form asp-action="Create" asp-controller="SupplierPayments" method="post" data-loader>
        @Html.AntiForgeryToken()

        <div class="form-grid">
            <div class="form-group">
                <label class="form-label">Supplier</label>
                <select asp-for="SupplierId" class="form-control" id="SupplierId" required>
                    <option value="">-- Select Supplier --</option>
                    @if (ViewBag.Suppliers != null)
                    {
                        foreach (var supplier in ViewBag.Suppliers)
                        {
                            <option value="@supplier.Value">@supplier.Text</option>
                        }
                    }
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">Payment Date</label>
                <input asp-for="PaymentDate" type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
            </div>

            <div class="form-group">
                <label class="form-label">Payment Method</label>
                <select asp-for="PaymentMethod" class="form-control">
                    <option value="Cash">Cash</option>
                    <option value="Bank">Bank</option>
                    <option value="Mobile Banking">Mobile Banking</option>
                    <option value="Cheque">Cheque</option>
                </select>
            </div>
        </div>

        <div class="form-group" style="margin-bottom:25px;">
            <label class="form-label">Remarks</label>
            <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="Payment remarks..."></textarea>
        </div>

        <h3 style="margin-bottom:15px; font-family: 'Space Grotesk';">Unpaid Purchases</h3>

        <div class="table-wrapper">
            <table id="purchaseTable">
                <thead>
                    <tr>
                        <th>Invoice No</th>
                        <th>Purchase Date</th>
                        <th>Grand Total</th>
                        <th>Paid</th>
                        <th>Due</th>
                        <th style="width:160px;">Payment</th>
                    </tr>
                </thead>
                <tbody id="purchaseTableBody">
                    <tr>
                        <td colspan="6" style="text-align:center; padding:30px; color:var(--fg-muted);">
                            Select a supplier to load unpaid purchases.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="payment-summary">
            <div class="summary-box">
                <div class="summary-row">
                    <span>Total Payment</span>
                    <strong id="totalPayment" style="color: var(--accent);">৳0.00</strong>
                </div>
                <div class="summary-row total">
                    <span>Payable Now</span>
                    <strong id="payableNow">৳0.00</strong>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <a href="@Url.Action("Index", "SupplierPayments")" class="btn-secondary">
                <i class="fas fa-arrow-left"></i> Cancel
            </a>
            <button type="submit" class="btn-primary">
                <i class="fas fa-money-bill-wave"></i> Save Payment
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function() {

            // ==========================================
            // SUPPLIER CHANGE
            // ==========================================
            $("#SupplierId").on("change", function() {
                var supplierId = $(this).val();

                $("#purchaseTableBody").html(`
                            <tr>
                                <td colspan="6" style="text-align:center;padding:30px; color:var(--fg-muted);">
                                    Loading...
                                </td>
                            </tr>
                        `);

                $("#totalPayment").text("৳0.00");
                $("#payableNow").text("৳0.00");

                if (!supplierId) {
                    $("#purchaseTableBody").html(`
                                <tr>
                                    <td colspan="6" style="text-align:center; padding:30px; color:var(--fg-muted);">
                                        Select a supplier to load unpaid purchases.
                                    </td>
                                </tr>
                            `);
                    return;
                }

                $.ajax({
                    url: '@Url.Action("GetSupplierPurchases", "SupplierPayments")',
                    type: "GET",
                    data: { supplierId: supplierId },
                    success: function(data) {
                        renderPurchases(data);
                    },
                    error: function(xhr) {
                        console.log(xhr);
                        $("#purchaseTableBody").html(`
                                    <tr>
                                        <td colspan="6" style="text-align:center; padding:30px; color:#f43f5e;">
                                            Failed to load purchases.
                                        </td>
                                    </tr>
                                `);
                    }
                });
            });

            // ==========================================
            // RENDER PURCHASES
            // ==========================================
            function renderPurchases(data) {
                var tbody = $("#purchaseTableBody");
                tbody.empty();

                if (!data || data.length === 0) {
                    tbody.html(`
                                <tr>
                                    <td colspan="6" style="text-align:center; padding:30px; color:var(--fg-muted);">
                                        No unpaid purchases found.
                                    </td>
                                </tr>
                            `);
                    return;
                }

                $.each(data, function(index, item) {
                    var due = parseFloat(item.dueAmount || 0);

                    var row = `
                                <tr>
                                    <td><strong>${escapeHtml(item.invoiceNo)}</strong></td>
                                    <td>${formatDate(item.purchaseDate)}</td>
                                    <td>৳${formatMoney(item.grandTotal)}</td>
                                    <td>৳${formatMoney(item.paidAmount)}</td>
                                    <td><strong style="color:#f43f5e;">৳${formatMoney(due)}</strong></td>
                                    <td>
                                        <input type="number" step="0.01" min="0" max="${due}" class="form-control payment-input" name="Purchases[${index}].CollectionAmount" data-index="${index}" data-due="${due}" value="0" />
                                        <input type="hidden" name="Purchases[${index}].PurchaseId" value="${item.purchaseId}" />
                                        <input type="hidden" name="Purchases[${index}].InvoiceNo" value="${escapeHtml(item.invoiceNo)}" />
                                        <input type="hidden" name="Purchases[${index}].DueAmount" value="${due}" />
                                    </td>
                                </tr>
                            `;

                    tbody.append(row);
                });

                calculateTotal();
            }

            // ==========================================
            // PAYMENT INPUT
            // ==========================================
            $(document).on("input", ".payment-input", function() {
                var value = parseFloat($(this).val()) || 0;
                var due = parseFloat($(this).data("due")) || 0;

                if (value > due) {
                    $(this).val(due);
                }
                if (value < 0) {
                    $(this).val(0);
                }

                calculateTotal();
            });

            // ==========================================
            // CALCULATE TOTAL
            // ==========================================
            function calculateTotal() {
                var total = 0;
                $(".payment-input").each(function() {
                    total += parseFloat($(this).val()) || 0;
                });

                $("#totalPayment").text("৳" + formatMoney(total));
                $("#payableNow").text("৳" + formatMoney(total));
            }

            // ==========================================
            // FORMAT MONEY
            // ==========================================
            function formatMoney(value) {
                return Number(value || 0).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            // ==========================================
            // FORMAT DATE
            // ==========================================
            function formatDate(value) {
                if (!value) return "";
                var date = new Date(value);
                if (isNaN(date.getTime())) return value;
                return date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "2-digit" });
            }

            // ==========================================
            // HTML ESCAPE
            // ==========================================
            function escapeHtml(value) {
                if (value == null) return "";
                return $("<div>").text(value).html();
            }

        });
    </script>
}