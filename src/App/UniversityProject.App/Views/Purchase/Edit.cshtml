@model UniversityProject.Core.Entities.Purchase
@{
    ViewData["Title"] = "Edit Purchase";
    Layout = "_Layout";
}

<style>
    /* Same styles as Create (condensed here for brevity, copy from Create.cshtml) */
    .form-container {
        max-width: 1100px;
        margin: 0 auto;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
    }

    .form-group {
        margin-bottom: 24px;
    }

    .form-label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: var(--fg-muted);
        margin-bottom: 8px;
        text-transform: uppercase;
    }

    .form-input, .form-select {
        width: 100%;
        padding: 14px 16px;
        background: var(--bg-deep);
        border: 1.5px solid var(--border);
        border-radius: 12px;
        color: var(--fg);
        font-size: 14px;
        outline: none;
        transition: all 0.3s ease;
    }

        .form-input:focus, .form-select:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-glow);
        }

    .form-select {
        appearance: none;
        cursor: pointer;
    }

    .item-table input {
        background: var(--bg-deep);
        border: 1px solid var(--border);
        border-radius: 8px;
        color: var(--fg);
        padding: 10px;
        width: 100%;
    }

        .item-table input:focus {
            outline: none;
            border-color: var(--accent);
        }

    .remove-row-btn {
        background: rgba(244, 63, 94, 0.1);
        border: 1px solid rgba(244, 63, 94, 0.2);
        color: #f43f5e;
        width: 36px;
        height: 36px;
        border-radius: 8px;
        cursor: pointer;
    }

    .totals-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 24px;
        margin-top: 32px;
        align-items: start;
    }

    .totals-box {
        background: var(--bg-deep);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 20px;
    }

    .total-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
        color: var(--fg-muted);
        font-size: 14px;
    }

        .total-row.grand {
            font-size: 20px;
            font-weight: 700;
            color: var(--fg);
            border-top: 1px solid var(--border);
            padding-top: 12px;
            margin-bottom: 0;
        }

    .btn-primary {
        background: linear-gradient(135deg, var(--accent), #008f55);
        color: #000;
        border: none;
        padding: 12px 24px;
        border-radius: 10px;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-secondary {
        background: transparent;
        color: var(--fg-muted);
        border: 1px solid var(--border);
        padding: 12px 24px;
        border-radius: 10px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .form-actions {
        display: flex;
        gap: 12px;
        justify-content: flex-end;
        margin-top: 32px;
        padding-top: 24px;
        border-top: 1px solid var(--border);
    }

    @@media (max-width: 768px) {
        .form-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="page-header">
    <h1>Edit Purchase</h1>
    <p>Update purchase details and items for <strong>@Model.InvoiceNo</strong>.</p>
</div>

<div class="panel form-container">
    <form asp-action="Edit" asp-controller="Purchases" method="post" data-loader>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="form-grid">
            <div class="form-group">
                <label class="form-label" asp-for="InvoiceNo">Invoice No</label>
                <input type="text" asp-for="InvoiceNo" class="form-input" required>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="PurchaseDate">Purchase Date</label>
                <input type="date" asp-for="PurchaseDate" class="form-input" required>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="SupplierId">Supplier</label>
                <select asp-for="SupplierId" class="form-select" asp-items="ViewBag.Suppliers" required></select>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="WarehouseId">Warehouse</label>
                <select asp-for="WarehouseId" class="form-select" asp-items="ViewBag.Warehouses" required></select>
            </div>
        </div>

        <h3 style="font-family: 'Space Grotesk'; margin: 30px 0 15px;">Purchase Items</h3>
        <div class="table-wrapper item-table" style="border-radius: 12px; border: 1px solid var(--border); overflow: hidden;">
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="background: var(--bg-panel);">
                        <th style="padding: 12px; text-align: left; width: 40%;">Product</th>
                        <th style="padding: 12px; text-align: left;">Qty</th>
                        <th style="padding: 12px; text-align: left;">Unit Price</th>
                        <th style="padding: 12px; text-align: left;">Total</th>
                        <th style="padding: 12px; text-align: center;">Action</th>
                    </tr>
                </thead>
                <tbody id="itemList">
                    @if (Model.PurchaseItem != null && Model.PurchaseItem.Any())
                    {
                        for (int i = 0; i < Model.PurchaseItem.Count; i++)
                        {
                            <tr class="item-row" style="border-top: 1px solid var(--border);">
                                <td style="padding: 10px;">
                                    <select name="PurchaseItem[@i].ProductId" class="form-control product-select" style="width:100%" required>
                                        @if (ViewBag.Products != null)
                                        {
                                            foreach (var p in (SelectList)ViewBag.Products)
                                            {
                                                if (p.Value == Model.PurchaseItem[i].ProductId.ToString())
                                                {
                                                    <option value="@p.Value" selected>@p.Text</option>
                                                }
                                                else
                                                {
                                                    <option value="@p.Value">@p.Text</option>
                                                }
                                            }
                                        }
                                    </select>
                                    <input type="hidden" name="PurchaseItem[@i].Id" value="@Model.PurchaseItem[i].Id" />
                                </td>
                                <td style="padding: 10px;"><input type="number" name="PurchaseItem[@i].Quantity" class="form-control qty-input" min="1" value="@Model.PurchaseItem[i].Quantity" required oninput="calculateRow(this)"></td>
                                <td style="padding: 10px;"><input type="number" name="PurchaseItem[@i].UnitPrice" class="form-control price-input" min="0" step="0.01" value="@Model.PurchaseItem[i].UnitPrice" required oninput="calculateRow(this)"></td>
                                <td style="padding: 10px; font-weight:600; color: var(--accent);"><span class="row-total">$@Model.PurchaseItem[i].Total.ToString("N2")</span></td>
                                <td style="padding: 10px; text-align: center;"><button type="button" class="remove-row-btn" onclick="removeRow(this)"><i class="fas fa-times"></i></button></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr class="item-row" style="border-top: 1px solid var(--border);">
                            <td style="padding: 10px;">
                                <select name="PurchaseItem[0].ProductId" class="form-control product-select" style="width:100%" required>
                                    <option value="">Select Product</option>
                                    @if (ViewBag.Products != null)
                                    {
                                        foreach (var p in (SelectList)ViewBag.Products)
                                        {
                                            <option value="@p.Value">@p.Text</option>
                                        }
                                    }
                                </select>
                            </td>
                            <td style="padding: 10px;"><input type="number" name="PurchaseItem[0].Quantity" class="form-control qty-input" min="1" value="1" required oninput="calculateRow(this)"></td>
                            <td style="padding: 10px;"><input type="number" name="PurchaseItem[0].UnitPrice" class="form-control price-input" min="0" step="0.01" value="0" required oninput="calculateRow(this)"></td>
                            <td style="padding: 10px; font-weight:600; color: var(--accent);"><span class="row-total">$0.00</span></td>
                            <td style="padding: 10px; text-align: center;"><button type="button" class="remove-row-btn" onclick="removeRow(this)"><i class="fas fa-times"></i></button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <button type="button" class="btn-secondary" style="margin-top: 15px;" onclick="addRow()"><i class="fas fa-plus"></i> Add Item</button>

        <div class="totals-grid">
            <div class="form-grid" style="grid-template-columns: 1fr 1fr;">
                <div class="form-group" style="margin-bottom: 0;">
                    <label class="form-label">Discount ($)</label>
                    <input type="number" asp-for="Discount" class="form-input" min="0" step="0.01" oninput="calculateGrandTotal()">
                </div>
                <div class="form-group" style="margin-bottom: 0;">
                    <label class="form-label">Tax (%)</label>
                    <input type="number" asp-for="Tax" class="form-input" min="0" step="0.01" oninput="calculateGrandTotal()">
                </div>
                <div class="form-group" style="margin-bottom: 0;">
                    <label class="form-label">VAT (%)</label>
                    <input type="number" asp-for="Vat" class="form-input" min="0" step="0.01" oninput="calculateGrandTotal()">
                </div>
                <div class="form-group" style="margin-bottom: 0;">
                    <label class="form-label">Transport Cost ($)</label>
                    <input type="number" asp-for="TransportCost" class="form-input" min="0" step="0.01" oninput="calculateGrandTotal()">
                </div>
            </div>

            <div class="totals-box">
                <div class="total-row"><span>Subtotal:</span> <span id="subTotalDisplay">$0.00</span></div>
                <div class="total-row"><span>Tax Amount:</span> <span id="taxDisplay">$0.00</span></div>
                <div class="total-row"><span>VAT Amount:</span> <span id="vatDisplay">$0.00</span></div>
                <div class="total-row"><span>Discount:</span> <span id="discountDisplay">-$0.00</span></div>
                <div class="total-row"><span>Transport:</span> <span id="transportDisplay">$0.00</span></div>
                <div class="total-row grand"><span>Grand Total:</span> <span id="grandTotalDisplay">$0.00</span></div>
                <input type="hidden" asp-for="GrandTotal" id="grandTotalInput">
            </div>
        </div>

        <div class="form-actions">
            <a href="@Url.Action("Index", "Purchases")" class="btn-secondary">Cancel</a>
            <button type="submit" class="btn-primary"><i class="fas fa-save"></i> Update Purchase</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        let rowIndex = @Model.PurchaseItem?.Count ?? 1;

        function addRow() {
            const tbody = document.getElementById('itemList');
            const firstRow = tbody.querySelector('.item-row');
            const newRow = firstRow.cloneNode(true);

            newRow.querySelectorAll('[name]').forEach(input => {
                input.name = input.name.replace(/\[\d+\]/, '[' + rowIndex + ']');
                if (input.type === 'hidden' && input.name.includes('.Id')) input.value = '';
                if (input.type === 'number') input.value = input.classList.contains('qty-input') ? 1 : 0;
                if (input.tagName === 'SELECT') input.selectedIndex = 0;
            });

            newRow.querySelector('.row-total').textContent = '$0.00';
            tbody.appendChild(newRow);
            rowIndex++;
            calculateGrandTotal();
        }

        function removeRow(btn) {
            const tbody = document.getElementById('itemList');
            if (tbody.querySelectorAll('.item-row').length > 1) {
                btn.closest('.item-row').remove();
                calculateGrandTotal();
            } else {
                showToast('At least one item is required.', 'info');
            }
        }

        function calculateRow(input) {
            const row = input.closest('.item-row');
            const qty = parseFloat(row.querySelector('.qty-input').value) || 0;
            const price = parseFloat(row.querySelector('.price-input').value) || 0;
            const total = qty * price;
            row.querySelector('.row-total').textContent = '$' + total.toFixed(2);
            calculateGrandTotal();
        }

        function calculateGrandTotal() {
            let subTotal = 0;
            document.querySelectorAll('.item-row').forEach(row => {
                const qty = parseFloat(row.querySelector('.qty-input').value) || 0;
                const price = parseFloat(row.querySelector('.price-input').value) || 0;
                subTotal += (qty * price);
            });

            const discount = parseFloat(document.querySelector('#Discount').value) || 0;
            const taxPercent = parseFloat(document.querySelector('#Tax').value) || 0;
            const vatPercent = parseFloat(document.querySelector('#Vat').value) || 0;
            const transport = parseFloat(document.querySelector('#TransportCost').value) || 0;

            const taxAmount = subTotal * (taxPercent / 100);
            const vatAmount = subTotal * (vatPercent / 100);
            const grandTotal = subTotal + taxAmount + vatAmount + transport - discount;

            document.querySelector('#subTotalDisplay').textContent = '$' + subTotal.toFixed(2);
            document.querySelector('#taxDisplay').textContent = '$' + taxAmount.toFixed(2);
            document.querySelector('#vatDisplay').textContent = '$' + vatAmount.toFixed(2);
            document.querySelector('#discountDisplay').textContent = '-$' + discount.toFixed(2);
            document.querySelector('#transportDisplay').textContent = '$' + transport.toFixed(2);
            document.querySelector('#grandTotalDisplay').textContent = '$' + grandTotal.toFixed(2);
            document.querySelector('#grandTotalInput').value = grandTotal.toFixed(2);
        }

        calculateGrandTotal();
    </script>
}