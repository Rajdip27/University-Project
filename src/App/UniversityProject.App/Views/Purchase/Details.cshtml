@model UniversityProject.Application.ViewModel.PurchaseDetailsViewModel

@{
    ViewData["Title"] = "Purchase Details";
    Layout = "_Layout";

    var subtotal = Model.Items?.Sum(x => x.Total) ?? 0;

    var taxAmount = subtotal * (Model.Tax / 100);

    var vatAmount = subtotal * (Model.Vat / 100);
}

<style>
    .details-container {
        max-width: 1100px;
        margin: 0 auto;
    }

    .details-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
        margin-bottom: 32px;
    }

    .detail-group {
        display: flex;
        flex-direction: column;
    }

    .detail-label {
        font-size: 13px;
        font-weight: 600;
        color: var(--fg-muted);
        margin-bottom: 8px;
        text-transform: uppercase;
    }

    .detail-value {
        font-size: 16px;
        color: var(--fg);
        padding: 14px 16px;
        background: var(--bg-deep);
        border: 1px solid var(--border);
        border-radius: 12px;
        min-height: 52px;
        display: flex;
        align-items: center;
    }

    .totals-box {
        background: var(--bg-deep);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 20px;
        margin-top: 24px;
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 20px;
    }

    .total-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
        color: var(--fg-muted);
        font-size: 14px;
    }

        .total-row.grand {
            font-size: 20px;
            font-weight: 700;
            color: var(--fg);
            border-top: 1px solid var(--border);
            padding-top: 12px;
            margin-bottom: 0;
        }

    .btn-primary {
        background: linear-gradient(135deg, var(--accent), #008f55);
        color: #000;
        border: none;
        padding: 12px 24px;
        border-radius: 10px;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-secondary {
        background: transparent;
        color: var(--fg-muted);
        border: 1px solid var(--border);
        padding: 12px 24px;
        border-radius: 10px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .detail-actions {
        display: flex;
        gap: 12px;
        justify-content: flex-end;
        margin-top: 32px;
        padding-top: 24px;
        border-top: 1px solid var(--border);
    }

    @@media (max-width: 768px) {
        .details-grid {
            grid-template-columns: 1fr;
        }

        .totals-box {
            grid-template-columns: 1fr;
        }

        .detail-actions {
            justify-content: flex-start;
            flex-wrap: wrap;
        }
    }
</style>


<div class="page-header">

    <h1>Purchase Details</h1>

    <p>
        Full information for Invoice
        <strong>@Model.InvoiceNo</strong>.
    </p>

</div>


<div class="panel details-container">

    <!-- ===================================== -->
    <!-- PURCHASE INFORMATION -->
    <!-- ===================================== -->

    <div class="details-grid">

        <div class="detail-group">

            <span class="detail-label">
                Invoice No
            </span>

            <div class="detail-value">
                @Model.InvoiceNo
            </div>

        </div>


        <div class="detail-group">

            <span class="detail-label">
                Purchase Date
            </span>

            <div class="detail-value">

                @Model.PurchaseDate.ToString("MMM dd, yyyy")

            </div>

        </div>


        <div class="detail-group">

            <span class="detail-label">
                Supplier
            </span>

            <div class="detail-value">

                @(string.IsNullOrWhiteSpace(Model.SupplierName)
                    ? "N/A"
                    : Model.SupplierName)

            </div>

        </div>


        <div class="detail-group">

            <span class="detail-label">
                Warehouse
            </span>

            <div class="detail-value">

                @(string.IsNullOrWhiteSpace(Model.WarehouseName)
                    ? "N/A"
                    : Model.WarehouseName)

            </div>

        </div>


        <div class="detail-group">

            <span class="detail-label">
                Tax
            </span>

            <div class="detail-value">
                @Model.Tax.ToString("N2")%
            </div>

        </div>


        <div class="detail-group">

            <span class="detail-label">
                VAT
            </span>

            <div class="detail-value">
                @Model.Vat.ToString("N2")%
            </div>

        </div>

    </div>


    <!-- ===================================== -->
    <!-- PURCHASE ITEMS -->
    <!-- ===================================== -->

    <h3 style="font-family: 'Space Grotesk'; margin-bottom: 15px;">
        Purchased Items
    </h3>


    <div class="table-wrapper">

        <table>

            <thead>

                <tr>

                    <th>
                        Product
                    </th>

                    <th>
                        Quantity
                    </th>

                    <th>
                        Unit Price
                    </th>

                    <th style="text-align: right;">
                        Total
                    </th>

                </tr>

            </thead>


            <tbody>

                @if (Model.Items == null || !Model.Items.Any())
                {
                    <tr>

                        <td colspan="4"
                            style="text-align:center; padding:20px; color:var(--fg-muted);">

                            No items found.

                        </td>

                    </tr>
                }
                else
                {
                    foreach (var item in Model.Items)
                    {
                        <tr>

                            <td>
                                @(
                                    string.IsNullOrWhiteSpace(item.ProductName)
                                        ? "Unknown Product"
                                        : item.ProductName
                                )
                            </td>


                            <td>
                                @item.Quantity.ToString("N2")
                            </td>


                            <td>
                                ৳@item.UnitPrice.ToString("N2")
                            </td>


                            <td style="
                                text-align:right;
                                color:var(--accent);
                                font-weight:600;">

                                ৳@item.Total.ToString("N2")

                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>


    <!-- ===================================== -->
    <!-- TOTALS -->
    <!-- ===================================== -->

    <div class="totals-box">

        <div></div>


        <div>

            <div class="total-row">

                <span>
                    Subtotal:
                </span>

                <span>
                    ৳@subtotal.ToString("N2")
                </span>

            </div>


            <div class="total-row">

                <span>
                    Tax (@Model.Tax.ToString("N2")%):
                </span>

                <span>
                    ৳@taxAmount.ToString("N2")
                </span>

            </div>


            <div class="total-row">

                <span>
                    VAT (@Model.Vat.ToString("N2")%):
                </span>

                <span>
                    ৳@vatAmount.ToString("N2")
                </span>

            </div>


            <div class="total-row">

                <span>
                    Discount:
                </span>

                <span>
                    -৳@Model.Discount.ToString("N2")
                </span>

            </div>


            <div class="total-row">

                <span>
                    Transport:
                </span>

                <span>
                    ৳@Model.TransportCost.ToString("N2")
                </span>

            </div>


            <div class="total-row grand">

                <span>
                    Grand Total:
                </span>

                <span>
                    ৳@Model.GrandTotal.ToString("N2")
                </span>

            </div>

        </div>

    </div>


    <!-- ===================================== -->
    <!-- ACTIONS -->
    <!-- ===================================== -->

    <div class="detail-actions">

        <a href="@Url.Action("Index", "Purchase")"
           class="btn-secondary">

            <i class="fas fa-arrow-left"></i>

            Back to List

        </a>


        <a href="@Url.Action("Edit", "Purchase", new { id = Model.Id })"
           class="btn-primary">

            <i class="fas fa-edit"></i>

            Edit Purchase

        </a>

    </div>

</div>